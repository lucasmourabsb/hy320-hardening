*filter
:HY320_IN4 - [0:0]
-F HY320_IN4
-A HY320_IN4 -i lo -j RETURN
-A HY320_IN4 -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
-A HY320_IN4 -s 10.0.0.0/8 -j RETURN
-A HY320_IN4 -s 172.16.0.0/12 -j RETURN
-A HY320_IN4 -s 192.168.0.0/16 -j RETURN
-A HY320_IN4 -s 169.254.0.0/16 -j RETURN
-A HY320_IN4 -p udp --sport 67 --dport 68 -j RETURN
-A HY320_IN4 -j DROP
COMMIT
